@page "/"
@attribute [Authorize]
@implements IDisposable
@inject AgencyContextState AgencyContext

<PageTitle>Home</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.H3">Letoryn</FluentLabel>

    @if (_showComingSoon)
    {
        <FluentLabel Typo="Typography.Body">
            Welcome to your agency workspace. Upcoming modules in later releases include lettings,
            compliance, finance, and reporting: all from this single shell.
        </FluentLabel>
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                <FluentLabel Typo="Typography.H5">Coming soon</FluentLabel>
                <FluentLabel>Lettings pipeline and property records</FluentLabel>
                <FluentLabel>Tenant compliance and document vault</FluentLabel>
                <FluentLabel>Rent and payment reconciliation</FluentLabel>
            </FluentStack>
        </FluentCard>
    }
    else
    {
        <FluentLabel>Select an agency or complete invitations to continue.</FluentLabel>
    }
</FluentStack>

@code {
    private bool _showComingSoon;

    protected override async Task OnInitializedAsync()
    {
        AgencyContext.Changed += OnContextChanged;
        await AgencyContext.WaitForShellBootstrapAsync();
        Refresh();
    }

    private void OnContextChanged()
    {
        Refresh();
        InvokeAsync(StateHasChanged);
    }

    private void Refresh()
    {
        _showComingSoon = AgencyContext.HasValidRoutineShellContext
            && AgencyContext.Profile?.Memberships.Any(m =>
                m.AgencyId == AgencyContext.ActiveAgencyId
                && m.Status == nameof(Letoryn.Domain.Memberships.MembershipStatus.Active)
                && m.Role is nameof(Letoryn.Domain.Memberships.AgencyRole.Administrator)
                    or nameof(Letoryn.Domain.Memberships.AgencyRole.StandardMember)) == true;
    }

    public void Dispose() => AgencyContext.Changed -= OnContextChanged;
}
