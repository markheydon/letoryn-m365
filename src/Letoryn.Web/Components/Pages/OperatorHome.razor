@page "/operator"
@attribute [Authorize]
@layout Letoryn.Web.Components.Layout.MinimalLayout

<PageTitle>Platform operator</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.H4">Platform operator</FluentLabel>
    <FluentLabel>
        You are signed in as a platform operator, but no agency assignments are configured yet.
        You can create an agency and be assigned automatically, or another operator can assign agencies to you.
    </FluentLabel>
    <FluentLink Href="/operator/agencies">Open agencies</FluentLink>
</FluentStack>
