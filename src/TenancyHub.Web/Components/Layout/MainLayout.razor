@inherits LayoutComponentBase
@implements IDisposable
@inject AgencyContextState AgencyContext
@inject UserSessionState SessionState
@inject TenancyHubApiClient ApiClient
@inject NavigationManager Navigation

<ShellBootstrap />

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" VerticalAlignment="VerticalAlignment.Center">
            <FluentLayoutHamburger />
            <FluentLabel Typo="Typography.H5">Tenancy Hub</FluentLabel>
            @if (!string.IsNullOrWhiteSpace(AgencyContext.ActiveAgencyDisplayName))
            {
                <FluentLabel>@AgencyContext.ActiveAgencyDisplayName</FluentLabel>
            }
            <AgencySwitcher />
            <FluentSpacer />
            <FluentButton OnClick="SignOutAsync">Sign out</FluentButton>
        </FluentStack>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content" Class="main">
        @if (_showInviteBanner)
        {
            <FluentMessageBar Intent="MessageBarIntent.Info">
                You have pending invitations.
                <FluentLink Href="/invitations">Review invitations</FluentLink>
            </FluentMessageBar>
        }
        <div class="content">
            @Body
        </div>
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _showInviteBanner;

    protected override void OnInitialized()
    {
        AgencyContext.Changed += OnContextChanged;
        RefreshBanner();
    }

    private void OnContextChanged()
    {
        RefreshBanner();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshBanner()
    {
        _showInviteBanner = AgencyContext.HasPendingInvites && AgencyContext.HasActiveMembership;
    }

    private async Task SignOutAsync()
    {
        try
        {
            await ApiClient.SignOutAsync();
        }
        catch
        {
            // Continue local sign-out even if API is unavailable.
        }

        SessionState.SessionId = null;
        SessionState.ApiSessionEstablished = false;
        await SessionState.PersistToBrowserAsync();
        AgencyContext.Clear();
        Navigation.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
    }

    public void Dispose() => AgencyContext.Changed -= OnContextChanged;
}
