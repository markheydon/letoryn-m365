@page "/agency-access-blocked"
@attribute [Authorize]
@layout TenancyHub.Web.Components.Layout.MinimalLayout
@inject AgencyContextState AgencyContext

<PageTitle>Agency access blocked</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.H4">Agency access blocked</FluentLabel>
    <FluentLabel>@(_message ?? "You cannot access an agency workspace at this time.")</FluentLabel>
</FluentStack>

@code {
    private string? _message;

    protected override void OnInitialized()
    {
        _message = AgencyContext.RoutineShellBlockedMessage;
    }
}
