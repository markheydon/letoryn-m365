@page "/audit"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization

<PageTitle>Audit history</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.H4">Audit history</FluentLabel>
    <FluentLabel Typo="Typography.Body">
        Accountability events for @AgencyContext.ActiveAgencyDisplayName, newest first.
    </FluentLabel>

    @if (_viewState is ViewState.PermissionDenied)
    {
        <FluentMessageBar Intent="MessageBarIntent.Warning">
            You do not have permission to view audit history for this agency.
        </FluentMessageBar>
    }
    else if (_viewState is ViewState.Loading && _items.Count == 0)
    {
        <FluentSpinner />
    }
    else if (_viewState is ViewState.LoadFailed && _items.Count == 0)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">
            @_loadErrorMessage
        </FluentMessageBar>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ReloadAsync">Try again</FluentButton>
    }
    else
    {
        @if (_items.Count == 0)
        {
            <FluentLabel>No audit events to display yet.</FluentLabel>
        }
        else
        {
            <FluentDataGrid Items="@_items.AsQueryable()"
                            GridTemplateColumns="10rem 1.5fr 1fr 2fr"
                            Loading="@_loadingMore">
                <TemplateColumn Title="When">
                    @{
                        var row = context;
                    }
                    @row.OccurredAt.ToString("g", UkCulture)
                </TemplateColumn>
                <PropertyColumn Property="@(e => e.ActorEmail)" Title="Actor" />
                <PropertyColumn Property="@(e => e.ActionType)" Title="Action" />
                <PropertyColumn Property="@(e => e.Summary)" Title="Summary" />
            </FluentDataGrid>
        }

        @if (!string.IsNullOrWhiteSpace(_nextCursor))
        {
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Disabled="_loadingMore"
                          OnClick="LoadMoreAsync">
                @(_loadingMore ? "Loading…" : "Load more")
            </FluentButton>
        }

        @if (_viewState is ViewState.LoadFailed && _items.Count > 0)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">
                @_loadErrorMessage
            </FluentMessageBar>
        }
    }
</FluentStack>

@code {
    private static readonly CultureInfo UkCulture = CultureInfo.GetCultureInfo("en-GB");

    [Inject]
    private AgencyContextState AgencyContext { get; set; } = default!;

    [Inject]
    private TenancyHubApiClient ApiClient { get; set; } = default!;

    private enum ViewState
    {
        Loading,
        Ready,
        PermissionDenied,
        LoadFailed,
    }

    private ViewState _viewState = ViewState.Loading;
    private readonly List<AgencyAuditItemDto> _items = [];
    private string? _nextCursor;
    private bool _loadingMore;
    private string _loadErrorMessage = "Unable to load audit history.";

    protected override async Task OnInitializedAsync()
    {
        AgencyContext.Changed += OnContextChanged;
        await AgencyContext.WaitForShellBootstrapAsync();
        await ReloadAsync();
    }

    private void OnContextChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        _items.Clear();
        _nextCursor = null;
        await LoadPageAsync(isInitialLoad: true);
    }

    private Task LoadMoreAsync() => LoadPageAsync(isInitialLoad: false);

    private async Task LoadPageAsync(bool isInitialLoad)
    {
        if (AgencyContext.Profile is null)
        {
            if (isInitialLoad)
            {
                _viewState = ViewState.LoadFailed;
                _loadErrorMessage = "Unable to load your profile. Try again later.";
            }

            return;
        }

        if (!AgencyContext.CanViewAgencyAudit || AgencyContext.ActiveAgencyId is not Guid agencyId)
        {
            _viewState = ViewState.PermissionDenied;
            _items.Clear();
            _nextCursor = null;
            return;
        }

        if (isInitialLoad)
        {
            _viewState = ViewState.Loading;
        }
        else
        {
            _loadingMore = true;
        }

        try
        {
            var result = await ApiClient.GetAgencyAuditAsync(agencyId, _nextCursor);
            switch (result.Access)
            {
                case AgencyAuditLoadAccess.Success when result.Page is not null:
                    _items.AddRange(result.Page.Items);
                    _nextCursor = result.Page.NextCursor;
                    _viewState = ViewState.Ready;
                    break;
                case AgencyAuditLoadAccess.Denied:
                    _items.Clear();
                    _nextCursor = null;
                    _viewState = ViewState.PermissionDenied;
                    break;
                default:
                    _loadErrorMessage = isInitialLoad
                        ? "Unable to load audit history. Try again later."
                        : "Unable to load more audit events. Try again.";
                    _viewState = _items.Count == 0 ? ViewState.LoadFailed : ViewState.Ready;
                    break;
            }
        }
        finally
        {
            _loadingMore = false;
        }
    }

    public void Dispose() => AgencyContext.Changed -= OnContextChanged;
}
